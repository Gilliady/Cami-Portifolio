FROM node:22-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install

# In dev mode, source code is mounted via volume.
# This CMD runs Astro in dev mode with hot reload, binding to 0.0.0.0
ENV HOST=0.0.0.0
ENV PORT=4321

EXPOSE 4321

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--force"]
