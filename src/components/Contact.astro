---
// Contact Section - Mobile First Pixel Perfect with Strapi CMS support
import type { ContentData } from '../data/translations';

interface Props {
  contentPt?: ContentData['contact'];
  contentEn?: ContentData['contact'];
}

const { contentPt, contentEn } = Astro.props;
const contactPortrait = contentPt?.portrait || contentEn?.portrait || '/images/contact_camila.webp';
const linkedinUrl = contentPt?.socials?.linkedin || contentEn?.socials?.linkedin || 'https://linkedin.com';
const whatsappUrl = contentPt?.socials?.whatsapp || contentEn?.socials?.whatsapp || 'https://wa.me/';
const contactEmail = contentPt?.socials?.email || contentEn?.socials?.email || 'mailto:contact@camiswd.com';
---

<section id="contact" class="reveal-section relative w-full min-h-[100svh] flex flex-col justify-center py-12 md:py-24 px-4 sm:px-8 md:px-12 max-w-[1400px] mx-auto">
  
  <!-- Content Grid: Two columns even on mobile as in Figma Reference! -->
  <div class="grid grid-cols-2 gap-3.5 sm:gap-8 lg:gap-14 items-center">
    
    <!-- Left Column: Overlapping Header + Social Icons + Chess Portrait -->
    <div class="flex flex-col w-full">
      <!-- Header with Social Icons on the left, overlapping top of portrait -->
      <div class="relative z-20 flex items-end gap-1.5 sm:gap-3 lg:gap-4 -mb-[0.18em] text-[52px] sm:text-[80px] md:text-[100px] lg:text-[135px] xl:text-[165px] 2xl:text-[185px] whitespace-nowrap">
        <h2 class="font-display text-[#fbc000] font-normal uppercase text-[1em] leading-[0.78] tracking-tight select-none">
          <span class="lang-text lang-en">CONTACT</span>
          <span class="lang-text lang-pt hidden">CONTATO</span>
        </h2>

        <!-- Social Icons Column: exact cap-to-baseline height (0.54em) of CONTACT/CONTATO -->
        <div class="flex flex-col justify-between items-center h-[0.54em] mb-[0.035em] shrink-0 text-[#fbc000]">
          <!-- LinkedIn -->
          <a
            href={linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-[0.15em] h-[0.15em] hover:text-white transition-colors duration-200 block"
            aria-label="LinkedIn Profile"
          >
            <svg class="w-full h-full fill-current block" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>

          <!-- WhatsApp -->
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-[0.15em] h-[0.15em] hover:text-white transition-colors duration-200 block"
            aria-label="WhatsApp Contact"
          >
            <svg class="w-full h-full fill-current block" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </a>

          <!-- Email -->
          <a
            href={contactEmail}
            class="w-[0.15em] h-[0.15em] hover:text-white transition-colors duration-200 block"
            aria-label="Send Email"
          >
            <svg class="w-full h-full fill-current block" viewBox="0 0 24 24">
              <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Chess Portrait -->
      <div class="relative z-10 w-full group">
        <div class="relative overflow-hidden rounded-tl-[20px] rounded-tr-none rounded-bl-[20px] rounded-br-[20px] aspect-[3/4] sm:aspect-[4/5] bg-black/40 border border-neutral-700/50 shadow-2xl transition-transform duration-500 group-hover:scale-[1.01]">
          <img
            src={contactPortrait}
            alt="Camila Ferreira - Chess portrait"
            class="w-full h-full object-cover object-top"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <!-- Contact Form Column -->
    <div class="flex flex-col justify-center font-montserrat">
      <form id="contact-form" class="flex flex-col gap-4 sm:gap-6 lg:gap-8 w-full font-montserrat">
        
        <!-- Name Field -->
        <div class="flex flex-col gap-1 sm:gap-2">
          <label for="name" class="text-[#fbc000] text-xs sm:text-base font-medium">
            <span class="lang-text lang-en">Name</span>
            <span class="lang-text lang-pt hidden">Nome</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full bg-transparent border-b border-[#fbc000] py-1 sm:py-2 px-0 text-white placeholder-neutral-500 focus:outline-none focus:border-white transition-colors duration-200 text-xs sm:text-base"
          />
        </div>

        <!-- Email Field -->
        <div class="flex flex-col gap-1 sm:gap-2">
          <label for="email" class="text-[#fbc000] text-xs sm:text-base font-medium">
            <span class="lang-text lang-en">E-mail</span>
            <span class="lang-text lang-pt hidden">E-mail</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full bg-transparent border-b border-[#fbc000] py-1 sm:py-2 px-0 text-white placeholder-neutral-500 focus:outline-none focus:border-white transition-colors duration-200 text-xs sm:text-base"
          />
        </div>

        <!-- Message Field -->
        <div class="flex flex-col gap-1 sm:gap-2">
          <label for="message" class="text-[#fbc000] text-xs sm:text-base font-medium">
            <span class="lang-text lang-en">Message</span>
            <span class="lang-text lang-pt hidden">Mensagem</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="2"
            required
            class="w-full bg-transparent border-b border-[#fbc000] py-1 sm:py-2 px-0 text-white placeholder-neutral-500 focus:outline-none focus:border-white transition-colors duration-200 resize-none text-xs sm:text-base"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <div class="pt-2">
          <button
            type="submit"
            class="w-full px-4 py-2 sm:px-10 sm:py-3.5 bg-[#fbc000] hover:bg-[#e5af00] text-black font-bold text-[11px] sm:text-sm tracking-wide rounded-full shadow-lg hover:shadow-[#fbc000]/20 transition-all duration-300 transform active:scale-95 cursor-pointer uppercase text-center"
          >
            <span class="lang-text lang-en">Contact Us</span>
            <span class="lang-text lang-pt hidden">Contact Us</span>
          </button>
        </div>

        <!-- Success Toast Alert -->
        <div id="form-feedback" class="hidden p-3 rounded-lg bg-[#fbc000]/15 border border-[#fbc000]/40 text-[#fbc000] text-xs font-medium">
          <span class="lang-text lang-en">Thank you! Your message has been sent successfully.</span>
          <span class="lang-text lang-pt hidden">Obrigado! Sua mensagem foi enviada com sucesso.</span>
        </div>

      </form>
    </div>

  </div>

  <!-- Bottom Footer Copyright & Anchor -->
  <div class="mt-14 sm:mt-20 pt-6 sm:pt-8 border-t border-neutral-800/60 flex flex-col sm:flex-row items-center justify-between text-[10px] sm:text-xs text-neutral-500 gap-3">
    <p>© 2026 Camila Ferreira. All rights reserved.</p>
    <a href="#hero" class="text-neutral-400 hover:text-[#fbc000] transition-colors flex items-center gap-1.5">
      <span>Back to top</span>
      <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
      </svg>
    </a>
  </div>

</section>
