---
// Header with language toggle - Pixel Perfect (No 'CF' as per Figma Reference)
---

<header class="fixed top-0 left-0 right-0 z-50 flex items-center justify-end md:justify-start px-4 py-3 sm:px-6 md:px-14 md:py-8 pointer-events-none">
  <!-- Language Switcher Pill (Top-Right on Mobile, Top-Left on Desktop & Tablet) -->
  <div class="pointer-events-auto bg-[#181818]/90 backdrop-blur-md border border-neutral-700/60 rounded-full p-1 flex items-center shadow-lg shadow-black/40">
    <button
      id="btn-lang-en"
      type="button"
      class="lang-toggle-btn px-3 py-1.5 text-xs font-bold leading-none rounded-full transition-all duration-300 flex items-center justify-center gap-1.5 cursor-pointer bg-[#fbc000] text-black shadow-sm"
      aria-label="EN - Switch to English"
      data-target-lang="en"
    >
      <span class="check-icon text-[10px] leading-none">✓</span>
      <svg class="w-4 h-3 rounded-[2px] shrink-0 shadow-[0_0_0_1px_rgba(0,0,0,0.15)]" viewBox="0 0 24 16" aria-hidden="true">
        <rect width="24" height="16" fill="#fff"/>
        <path d="M0 0h24v1.23H0zm0 2.46h24v1.23H0zm0 2.46h24v1.23H0zm0 2.46h24v1.23H0zm0 2.46h24v1.23H0zm0 2.46h24v1.23H0zm0 2.47h24V16H0z" fill="#b22234"/>
        <rect width="10.5" height="8.6" fill="#3c3b6e"/>
        <circle cx="2.2" cy="2" r=".55" fill="#fff"/><circle cx="5.2" cy="2" r=".55" fill="#fff"/><circle cx="8.2" cy="2" r=".55" fill="#fff"/>
        <circle cx="3.7" cy="4.3" r=".55" fill="#fff"/><circle cx="6.7" cy="4.3" r=".55" fill="#fff"/>
        <circle cx="2.2" cy="6.6" r=".55" fill="#fff"/><circle cx="5.2" cy="6.6" r=".55" fill="#fff"/><circle cx="8.2" cy="6.6" r=".55" fill="#fff"/>
      </svg>
      <span class="leading-none">EN</span>
    </button>
    <button
      id="btn-lang-pt"
      type="button"
      class="lang-toggle-btn px-3 py-1.5 text-xs font-bold leading-none rounded-full transition-all duration-300 flex items-center justify-center gap-1.5 cursor-pointer text-neutral-400 hover:text-white"
      aria-label="PT - Mudar para Português"
      data-target-lang="pt"
    >
      <span class="check-icon hidden text-[10px] leading-none">✓</span>
      <svg class="w-4 h-3 rounded-[2px] shrink-0 shadow-[0_0_0_1px_rgba(0,0,0,0.15)]" viewBox="0 0 24 16" aria-hidden="true">
        <rect width="24" height="16" fill="#009b3a"/>
        <polygon points="12,2 21.5,8 12,14 2.5,8" fill="#fedf00"/>
        <circle cx="12" cy="8" r="3.4" fill="#002776"/>
        <path d="M8.8 7.5a6 6 0 0 1 6.4 1.3" fill="none" stroke="#fff" stroke-width="0.65"/>
      </svg>
      <span class="leading-none">PT</span>
    </button>
  </div>
</header>
