---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import ProjectModal from '../components/ProjectModal.astro';
import { getPortfolioContent } from '../lib/strapi';

// Fetch bilingual content from Strapi (with automatic fallback to static content)
const contentPt = await getPortfolioContent('pt');
const contentEn = await getPortfolioContent('en');
---

<Layout favicon={contentPt.favicon || contentEn.favicon}>
  <Header />

  <main class="w-full overflow-hidden">
    <Hero contentPt={contentPt.hero} contentEn={contentEn.hero} />
    <About contentPt={contentPt.about} contentEn={contentEn.about} />
    <Projects projectsPt={contentPt.projects.items} projectsEn={contentEn.projects.items} />
    <Contact contentPt={contentPt.contact} contentEn={contentEn.contact} />
  </main>

  <ProjectModal />

  <!-- Minimalist Scroll-Down Double-V Arrow (2 wide-open Vs, top smaller than bottom) -->
  <button
    id="scroll-next-btn"
    type="button"
    aria-label="Scroll to next section"
    class="fixed bottom-4 md:bottom-6 left-1/2 -translate-x-1/2 z-40 p-2 text-[#fbc000]/80 hover:text-[#fbc000] transition-opacity duration-300 cursor-pointer animate-bounce focus:outline-none"
  >
    <svg width="32" height="24" viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <!-- Top smaller, wide-open V -->
      <path d="M9 4L16 10L23 4" opacity="0.7" />
      <!-- Bottom larger, wide-open V -->
      <path d="M4 11L16 20L28 11" />
    </svg>
  </button>

  <!-- Language switcher & form interaction client script -->
  <script>
    type Language = 'en' | 'pt';

    let currentLang: Language = 'en';

    const btnEn = document.getElementById('btn-lang-en');
    const btnPt = document.getElementById('btn-lang-pt');

    function updateLanguageUI(lang: Language) {
      currentLang = lang;
      document.documentElement.lang = lang;

      // Update button active states
      if (lang === 'en') {
        btnEn?.classList.remove('text-neutral-400', 'hover:text-white');
        btnEn?.classList.add('bg-[#fbc000]', 'text-black', 'shadow-sm');
        btnEn?.querySelector('.check-icon')?.classList.remove('hidden');

        btnPt?.classList.remove('bg-[#fbc000]', 'text-black', 'shadow-sm');
        btnPt?.classList.add('text-neutral-400', 'hover:text-white');
        btnPt?.querySelector('.check-icon')?.classList.add('hidden');
      } else {
        btnPt?.classList.remove('text-neutral-400', 'hover:text-white');
        btnPt?.classList.add('bg-[#fbc000]', 'text-black', 'shadow-sm');
        btnPt?.querySelector('.check-icon')?.classList.remove('hidden');

        btnEn?.classList.remove('bg-[#fbc000]', 'text-black', 'shadow-sm');
        btnEn?.classList.add('text-neutral-400', 'hover:text-white');
        btnEn?.querySelector('.check-icon')?.classList.add('hidden');
      }

      // Toggle text elements
      document.querySelectorAll('.lang-text.lang-en').forEach((el) => {
        if (lang === 'en') {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      document.querySelectorAll('.lang-text.lang-pt').forEach((el) => {
        if (lang === 'pt') {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      // Save preference
      localStorage.setItem('portfolio_lang', lang);
    }

    // Attach listeners
    btnEn?.addEventListener('click', () => updateLanguageUI('en'));
    btnPt?.addEventListener('click', () => updateLanguageUI('pt'));

    // Check saved preference or browser language on load
    const saved = localStorage.getItem('portfolio_lang') as Language | null;
    if (saved === 'en' || saved === 'pt') {
      updateLanguageUI(saved);
    } else {
      // Default to PT if browser is pt-BR or pt, else EN
      const navLang = navigator.language.toLowerCase();
      if (navLang.startsWith('pt')) {
        updateLanguageUI('pt');
      } else {
        updateLanguageUI('en');
      }
    }

    // Contact Form handling (supports sending to Strapi messages API if configured)
    const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
    const feedback = document.getElementById('form-feedback');

    contactForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(contactForm);
      const payload = {
        name: formData.get('name'),
        email: formData.get('email'),
        message: formData.get('message'),
      };

      try {
        // Attempt post to Strapi if endpoint exists
        await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).catch(() => {});
      } catch (err) {}

      if (feedback) {
        feedback.classList.remove('hidden');
        contactForm.reset();
        setTimeout(() => {
          feedback.classList.add('hidden');
        }, 5000);
      }
    });

    // Scroll-reveal entrance animations for sections
    const revealEls = Array.from(document.querySelectorAll('.reveal-section'));
    const checkVisible = () => {
      const vh = window.innerHeight || document.documentElement.clientHeight;
      revealEls.forEach((el) => {
        if (el.classList.contains('is-visible')) return;
        const rect = el.getBoundingClientRect();
        if (rect.top <= vh - 60) {
          el.classList.add('is-visible');
        }
      });
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.01, rootMargin: '0px 0px -60px 0px' }
      );
      revealEls.forEach((el) => observer.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }

    window.addEventListener('scroll', checkVisible, { passive: true });
    checkVisible();

    // Minimalist Scroll-Next-Section Button
    const scrollNextBtn = document.getElementById('scroll-next-btn');
    const sections = ['hero', 'about', 'projects', 'contact']
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));

    function updateScrollArrowVisibility() {
      if (!scrollNextBtn || sections.length === 0) return;
      const lastSection = sections[sections.length - 1];
      const rect = lastSection.getBoundingClientRect();
      // Hide arrow once the last section (#contact) is mostly in view
      if (rect.top <= window.innerHeight * 0.45) {
        scrollNextBtn.classList.add('opacity-0', 'pointer-events-none');
      } else {
        scrollNextBtn.classList.remove('opacity-0', 'pointer-events-none');
      }
    }

    scrollNextBtn?.addEventListener('click', () => {
      const scrollY = window.scrollY;
      const next = sections.find((sec) => sec.offsetTop > scrollY + 40);
      if (next) {
        next.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    window.addEventListener('scroll', updateScrollArrowVisibility, { passive: true });
    window.addEventListener('resize', updateScrollArrowVisibility, { passive: true });
    updateScrollArrowVisibility();
  </script>
</Layout>
