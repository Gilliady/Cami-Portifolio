{
  "kind": "singleType",
  "collectionName": "general_infos",
  "info": {
    "singularName": "general-info",
    "pluralName": "general-infos",
    "displayName": "General Info",
    "description": "Hero, About, Bio, Stats and Social media configuration"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "heroTagline": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroName": {
      "type": "string",
      "default": "CAMILA FERREIRA"
    },
    "heroTitle": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroDescription": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "aboutHeading": {
      "type": "string",
      "default": "SOBRE",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "aboutBio": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "portfolio.stat",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "linkedinUrl": {
      "type": "string"
    },
    "whatsappUrl": {
      "type": "string"
    },
    "contactEmail": {
      "type": "email"
    }
  }
}
